#!/bin/bash
#
# Wrapper for `claude` that repairs /root/.claude.json before launching the
# real binary.
#
# Claude Code has a built-in corruption-rotation: when it can't parse
# .claude.json it `mv`s the file into ~/.claude/backups/ and writes a fresh
# real file in its place. On Unraid this is destructive: our persistence
# design symlinks /root/.claude.json to USB, and `mv` of a symlink moves
# the symlink — leaving /root/.claude.json as a real file in RAM (lost on
# reboot) while the original USB-resident config sits orphaned. Subsequent
# writes never reach USB.
#
# This wrapper restores the invariant on every launch.

CONFIG_DIR="/boot/config/plugins/claude-code/claude-config"
USB_TARGET="${CONFIG_DIR}/.claude.json"
LINK="/root/.claude.json"

repair_link() {
  # Already correct — nothing to do.
  if [ -L "$LINK" ] && [ "$(readlink "$LINK" 2>/dev/null)" = "$USB_TARGET" ]; then
    return 0
  fi
  # USB-side parent missing (USB unmounted, plugin not installed) — leave the
  # link alone rather than create a dangling one. Let claude surface the real
  # error itself.
  [ -d "$CONFIG_DIR" ] || return 0

  if [ -e "$LINK" ] && [ ! -L "$LINK" ]; then
    # Real file/dir at $LINK — rescue it before replacing. If the rescue
    # can't be done, leave the file in place: never destroy user data we
    # can't first preserve.
    local rescue="/tmp/claude-rescue-$(date +%s)-$$"
    if ! mkdir -p "$rescue" 2>/dev/null || ! mv "$LINK" "$rescue/.claude.json" 2>/dev/null; then
      echo "[claude] could not rescue /root/.claude.json — leaving it in place" >&2
      return 0
    fi
    echo "[claude] rescued real /root/.claude.json -> $rescue/.claude.json" >&2
  elif [ -L "$LINK" ]; then
    # Wrong-target symlink — safe to remove.
    rm -f "$LINK"
  fi

  [ -f "$USB_TARGET" ] || touch "$USB_TARGET" 2>/dev/null
  [ -f "$USB_TARGET" ] || return 0   # don't create a dangling symlink
  ln -s "$USB_TARGET" "$LINK" 2>/dev/null
}

repair_link

# Find the newest runnable versioned binary. The install/update path always
# creates /root/.local/share/claude/versions/<ver> alongside a symlink at
# /root/.local/bin/claude — we scan versions/ directly so a stale symlink can't
# point us at a missing file.
find_binary() {
  local vdir=/root/.local/share/claude/versions
  [ -d "$vdir" ] || return 1
  local v
  for v in $(ls -t "$vdir" 2>/dev/null); do
    if [ -f "$vdir/$v" ] && [ -x "$vdir/$v" ]; then
      echo "$vdir/$v"
      return 0
    fi
  done
  return 1
}

BIN=$(find_binary)
if [ -z "$BIN" ]; then
  echo "[claude] no runnable binary found under /root/.local/share/claude/versions/" >&2
  echo "[claude] run: /usr/local/emhttp/plugins/claude-code/scripts/update-claude" >&2
  exit 127
fi

# Write-back: if Claude's auto-updater installed a newer version, persist it to
# USB so reboots restore the latest rather than the old cached copy.
USB_DIR="/boot/config/plugins/claude-code/bin"
if [ -d "$USB_DIR" ]; then
  CURRENT_VER=$(basename "$BIN")
  if [ "$CURRENT_VER" != "$(cat "${USB_DIR}/version" 2>/dev/null)" ]; then
    cp "$BIN" "${USB_DIR}/claude" 2>/dev/null && echo "$CURRENT_VER" > "${USB_DIR}/version" 2>/dev/null || true
  fi
fi

exec "$BIN" "$@"
